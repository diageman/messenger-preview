{
  "mcpServers": {
    "mcp-proxy": {
      "command": "node",
      "args": [
        "C:/Projects/mcp-proxy/build/index.js"
      ]
    },
    "messenger-fs": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:/Projects/Messenger",
        "C:/Projects/mcp-proxy"
      ]
    },
    "logic-planner": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "playwright-tester": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp"
      ]
    },
    "database-explorer": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:postgres@127.0.0.1:5432/postgres"
      ]
    }
  },
  "$version": 3
}